.TH TOK 2
.SH NAME
tokparse, tokfree, tokat, tokbefore, tokhas, tokcomp, tokpatfree, toknbind, tokbindname, tokexec, tokbexec \- match patterns of tokens
.SH SYNOPSIS
.ta \w'Toks*\ \ \ 'u
.B #include <u.h>
.br
.B #include <libc.h>
.br
.B #include <regexp.h>
.br
.B #include <tok.h>
.PP
.B
Toks*	tokparse(char *text, long ntext, char *lines, long nlines)
.PP
.B
void	tokfree(Toks *t)
.PP
.B
int	tokat(Toks *t, long q)
.PP
.B
int	tokbefore(Toks *t, long q)
.PP
.B
int	tokhas(Tnames *n, char *name)
.PP
.B
Tpat*	tokcomp(char *pat)
.PP
.B
void	tokpatfree(Tpat *p)
.PP
.B
int	toknbind(Tpat *p)
.PP
.B
char*	tokbindname(Tpat *p, int i)
.PP
.B
int	tokexec(Tpat *p, Toks *t, int t0, int t1, int from, Tmatch *m)
.PP
.B
int	tokbexec(Tpat *p, Toks *t, int t0, int t1, Tmatch *m)
.PP
.B
void*	emalloc(ulong n)
.PP
