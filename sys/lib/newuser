#!/bin/rc

user=`{cat /dev/user}
home=/usr/$user
if(test -f $home/lib/profile){
	echo user directories already made
	exit no
}
cd $home
mkdir -p bin/rc bin/$cputype
mkdir -p lib tmp
bind -c $home/tmp /tmp

cat > lib/profile <<'!'
bind -a $home/bin/rc /bin
bind -a $home/bin/$cputype /bin
bind -c $home/tmp /tmp
test -e $home/lib/pkg && pkg add -f $home/lib/pkg
test -e $home/lib/factotum && cat $home/lib/factotum >/mnt/factotum/ctl
# $auth, the machine this page came from, serves its / to import(4): its /net, for /net/tcp, and
# webfs, and to its accounts /adm and /mnt/keys. A passkey signs you in (factotum(4)'s webauthn):
#	import ws!$auth!9p / /n/$auth; bind -a /n/$auth/net /net
font = /lib/font/bit/Iosevka/12a/font,/lib/font/bit/Iosevka/24a/font
switch($service){
case terminal
	# sound is shared: mixfs binds over /dev/audio, so a second play mixes with the first
	if(test -e /dev/audio && ! grep -s '^mix ' /dev/volume >/dev/null){
		audio/mixfs &
		mix=$apid
		while(test -e /proc/$mix/status && ! grep -s '^mix ' /dev/volume >/dev/null)
			sleep 0.1
	}
	plumber
	dropped &
	prompt=('% ' '	')
	fn %{ $* }
	exec hotkey rio -i riostart
}
!
if(! test -e lib/plumbing)
	cat > lib/plumbing <<!
# to update: cp /usr/$user/lib/plumbing /mnt/plumb/rules

editor = acme

include basic

!
if(! test -e lib/pkg)
	cat > lib/pkg <<!
# the packages the profile adds (pkg(1)): a name, a name and a hash, or a path, a line each
git9
!
if(! test -e lib/hotkey/acme){
	mkdir -p lib/hotkey
	echo include acme.emacs >lib/hotkey/acme
}
if(! test -e README)
	cat > README <<'!'
This is Acme, the Plan 9 text editor, in a window of rio, the Plan 9 window
system, in your browser. Each program runs here, on p9web, a Plan 9 kernel in
WebAssembly: no server runs your commands. Files you keep in this directory stay
in this browser.

The mouse:
	left button (B1)	select text
	middle button (B2)	run the text as a command
	right button (B3)	open a file, or look for the text
On a Mac, Option-click is B2 and Command-click is B3.

On the background, button 3 is rio's menu: choose New, then sweep the new
window with button 3 (on a Mac, Command-drag). Drag a window's border with
button 1 to resize it, or button 3 to move it.

To run a command, type it anywhere, then click it with B2. Try ls /bin or
echo hello. The window on the right is win: rc, the Plan 9 shell, in an Acme
window. Type a command at its end and press Return; Del interrupts it
(on a Mac, Fn-Delete).
man acme shows Acme's manual page.

B2 on New makes a window, and B2 on Put saves a file. B3 on a file name, such
as README, opens it, and B3 on a page name, such as acme(4), shows
that manual page: the plumber sends them to Acme.

Drop a file or a directory on the page to open it here, as B3 on its name
would: text in Acme, a PDF or an image in page, and an MP3, M4A, Ogg, FLAC or WAV plays
(the browser lets sound start after a click on the page; delete the window to
stop it). It is kept in the directory drop here.
To save a file to your computer, run download file.
!

. lib/profile
