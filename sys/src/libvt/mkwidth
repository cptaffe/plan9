#!/bin/rc
# mkwidth EastAsianWidth.txt DerivedGeneralCategory.txt >width.c: vtwidth's table, from the
# Unicode Character Database. W and F are two columns; Mn, Me and Cf, but for the soft hyphen,
# and the Hangul medial vowels and finals and U+200B, are none.
awk '
function hex(s,  i, n) {
	n = 0
	for(i = 1; i <= length(s); i++)
		n = n*16 + index("0123456789ABCDEF", substr(s, i, 1)) - 1
	return n
}
FNR == 1 { file++ }
/^#/ || NF == 0 { next }
{
	sub(/#.*/, "")
	split($0, f, ";")
	r = f[1]; p = f[2]
	gsub(/[ \t]/, "", r); gsub(/[ \t]/, "", p)
	n = split(r, a, /\.\./)
	lo = hex(a[1]); hi = n > 1 ? hex(a[2]) : lo
	if(file == 1 && (p == "W" || p == "F"))
		for(c = lo; c <= hi; c++) w[c] = 2
	if(file == 2 && (p == "Mn" || p == "Me" || p == "Cf"))
		for(c = lo; c <= hi; c++) if(c != 173) w[c] = 0
}
END {
	for(c = 4448; c <= 4607; c++) w[c] = 0
	w[8203] = 0
	print "#include <u.h>"
	print "#include <libc.h>"
	print "#include <vt.h>"
	print ""
	print "/* made by mkwidth from Unicode 15.1.0: the runes not one column wide */"
	print "static Rune width[][3] = {"
	lo = -1
	for(c = 0; c <= 1114112; c++){
		v = (c in w) && c < 1114112 ? w[c] : 1
		if(lo >= 0 && (v != cur || c == 1114112)){
			printf "\t{0x%04X, 0x%04X, %d},\n", lo, c-1, cur
			lo = -1
		}
		if(lo < 0 && v != 1){ lo = c; cur = v }
	}
	print "};"
	print ""
	print "int"
	print "vtwidth(Rune r)"
	print "{"
	print "\tint lo, hi, m;"
	print ""
	print "\tif(r < 0x20 || r >= 0x7F && r < 0xA0)"
	print "\t\treturn 0;"
	print "\tif(r < 0x300)"
	print "\t\treturn 1;"
	print "\tlo = 0;"
	print "\thi = nelem(width) - 1;"
	print "\twhile(lo <= hi){"
	print "\t\tm = (lo + hi) / 2;"
	print "\t\tif(r < width[m][0])"
	print "\t\t\thi = m - 1;"
	print "\t\telse if(r > width[m][1])"
	print "\t\t\tlo = m + 1;"
	print "\t\telse"
	print "\t\t\treturn width[m][2];"
	print "\t}"
	print "\treturn 1;"
	print "}"
}' $1 $2
