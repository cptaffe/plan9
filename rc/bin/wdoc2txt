#!/bin/rc

switch($#*){
case 0
	exit
case 1
	ifs='' { q=`{echo -n $1 | sed 's/''/''''/g'} }
	q=''''^$"q^''''
	switch($1){
	case *.rtf
		pub/rtf2text $1 >[2]/dev/null | plumb -i -d edit -a 'action=showdata filename='$q
	case *.doc *
		doc2txt $1 | plumb -i -d edit -a 'action=showdata filename='$q
	}
	exit
case *
	for(i in *)
		wdoc2txt $i
}
