#!/bin/rc
# E file - B file, wait until it changes, exit
rfork e
if (! ~ $#* 1) {
	echo usage: $0 file >[1=2]
	exit usage
}
if (! test -e $1) {
	echo $0: $1: no such file >[1=2]
	exit no-file
}
otm = `{mtime $1 | awk '{print $1}'}
if(! B $1)
	exit $status
while (~ $otm `{mtime $1 | awk '{print $1}'})
	sleep 1
exit ''
