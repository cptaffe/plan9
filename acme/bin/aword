#!/bin/rc
rfork e
if(! ~ $#* 0)
	winid=$1
if(~ $#winid 0){
	echo usage: aword [winid] >[1=2]
	exit usage
}
cd /mnt/acme/$winid || exit nowin
{
	echo -n 'addr=dot' >ctl
	a=`{cat addr}
	if(! ~ $a(1) $a(2)){
		cat xdata
		exit
	}
	echo -n -+ >[1=3]
	l=`{cat addr}
	cat xdata | awk -v 'q='$a(1) -v 'l='$l(1) '
	NR == 1 {
		i = q - l
		j = i + 1
		while(i > 0 && substr($0, i, 1) ~ /[A-Za-z]/)
			i--
		while(j <= length($0) && substr($0, j, 1) ~ /[A-Za-z]/)
			j++
		if(j > i + 1)
			print substr($0, i + 1, j - i - 1)
	}'
} <>[3]addr
