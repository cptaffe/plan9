#!/bin/rc
rfork e
if(! ~ $#* 1 2 || ~ $#winid 0){
	echo usage: lspq kind [arg] >[1=2]
	exit usage
}
if(! test -e /mnt/lsp/$1){
	echo 'no language server: lspfs(4) is not mounted on /mnt/lsp' >[1=2]
	exit nolsp
}
f=`{sed 1q /mnt/acme/$winid/tag | awk '{print $1}'}
{
	echo -n 'addr=dot' >/mnt/acme/$winid/ctl
	q=`{cat <[0=3]}
} <[3]/mnt/acme/$winid/addr
switch($1){
case syms fmt
	at=$f
case act
	at=$f':#'$q(1)^',#'^$q(2)
case *
	at=$f':#'$q(1)
}
if(~ $#* 2)
	at=$at' '$2
exec lsp $1 $at
