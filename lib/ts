# The languages hl(1) colors, by tree-sitter's programs, /bin/ts/name (ts(1)): one a line,
# ts=name file=pattern fence=pattern, where file's regexp(6) matches a window's file name and
# fence's the other names of a fenced block's language in markdown, besides name itself.
# $home/lib/ts is read in place of this file.
ts=c file="\.([ch]|def|cpp|cc|cxx|hpp)$" fence="^h$"
ts=markdown file="(\.(md|markdown)|/README)$" fence="^md$"
ts=go file="\.go$"
ts=python file="\.py$" fence="^(py|python3)$"
ts=rust file="\.rs$" fence="^rs$"
ts=javascript file="\.(js|mjs|cjs|jsx)$" fence="^(js|jsx|mjs|cjs)$"
ts=bash file="\.sh$" fence="^(sh|shell|zsh)$"
ts=java file="\.java$"
ts=scala file="\.(scala|sc)$"
ts=typescript file="\.(ts|mts|cts)$" fence="^ts$"
ts=tsx file="\.tsx$"
ts=yaml file="\.(yaml|yml)$" fence="^yml$"
ts=json file="\.json$"
ts=toml file="\.toml$"
ts=mermaid file="\.(mmd|mermaid)$" fence="^mmd$"
ts=pic file="\.pic$"
ts=goyacc file="\.go\.y$"
ts=yacc file="\.y$" fence="^(y|bison)$"
