# root
mount -aC #s/boot /root $rootspec
bind -a $rootdir /
bind -c $rootdir/mnt /mnt

# kernel devices
bind #c /dev
bind #d /fd
bind -c #e /env
bind #p /proc
bind -c #s /srv
bind -a #m /dev
bind -a #i /dev
bind -a #A /dev

# authentication
mount -a /srv/factotum /mnt
# the web: #W, p9web's webfs in the kernel (Plan 9's termrc runs webfs(4))
bind '#W' /mnt/web
# the network: #I, whose ws dials WebSockets: srv ws!host!9p name
bind -a #I /net

# the file server of /usr: fossil, on #S (boot's usrfs)
mount -c #s/fossil /usr

# standard bin
bind /$cputype/bin /bin
bind -a /rc/bin /bin
# a #!/bin/sh script's shell: APE's, a POSIX shell
bind /$cputype/bin/ape/sh /bin/sh

bind -c /usr/$user/tmp /tmp
cd /usr/$user

. /lib/namespace.local
. /lib/namespace.$sysname
. /cfg/$sysname/namespace
