# root
mount -aC #s/boot /root $rootspec
bind -a $rootdir /
bind -c $rootdir/mnt /mnt

# kernel devices
bind #c /dev
bind #d /fd
bind -c #e /env
bind #p /proc
bind -c #s /srv
bind -a #m /dev
bind -a #i /dev
bind -a #A /dev

# the file server of /usr
bind -c #O/usr /usr

# standard bin
bind /$cputype/bin /bin
bind -a /rc/bin /bin

bind -c /usr/$user/tmp /tmp
cd /usr/$user

. /lib/namespace.local
. /lib/namespace.$sysname
. /cfg/$sysname/namespace
