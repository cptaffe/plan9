# The namespace of sibyl's commands (sibylns(1)). sibylns's own file mounts #s/$sibyl.ro on /
# first (exportfs's -R of the user's /, in which this file is found), includes this file, then
# mounts the project, writable. $sibyl names the services sibylns posts. /tmp is new, in
# memory; /srv, /net and /n are empty, and so is /mnt but for the places sibylns may mount; the
# devices are new: #c, #d, #p, and a copy of #e.
mount -c #s/$sibyl.tmp /tmp
bind #c /dev
bind #d /fd
bind #p /proc
bind -c #e /env
bind /tmp/.none /srv
bind /tmp/.none /net
bind /tmp/.none /net.alt
bind /tmp/.none /n
bind /tmp/.mnt /mnt
