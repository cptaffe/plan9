# acme.rc: functions for acme clients in rc (acmeevent(1)): plan9port's lib/acme.rc, with
# acme's files at /mnt/acme rather than through 9p, and events written back on the
# descriptor they were read from. A client defines fn event and runs
# wineventloop; each event comes as "event c1 c2 q0 q1 eq0 eq1 flag textlen text chordarg chordaddr".

fn newwindow {
	winctl=`{cat /mnt/acme/new/ctl}
	winid=$winctl(1)
}

fn winctl {
	echo $* >/mnt/acme/$winid/ctl
}

fn winread {
	cat /mnt/acme/$winid/$1
}

fn winwrite {
	cat >/mnt/acme/$winid/$1
}

fn windump {
	if(! ~ $1 - '')
		winctl dumpdir $1
	if(! ~ $2 - '')
		winctl dump $2
}

fn winname {
	winctl name $1
}

# An event goes back on the descriptor it was read from, wineventloop's 3: this acme takes
# a write of an event only from the reader that has it in flight (xfideventwrite's evhead).
fn winwriteevent {
	echo $1$2$3 $4 >[1=3]
}

# windotlines: the text of the whole lines that dot touches, or of the line it is on if it is
# empty. addr stays open on 3 while it is set and read: an open of addr with none open resets it.
# Each end is a line of its own (#q-+), read back, as acme takes a,b-+ for more than one line.
fn windotlines {
	{
		winctl 'addr=dot'
		q=`{cat <[0=3]}
		e=`{echo $q | awk '{print ($2 > $1 ? $2-1 : $1)}'}
		echo -n '#'^$q(1)^'-+' | winwrite addr
		a=`{winread addr}
		echo -n '#'^$e^'-+' | winwrite addr
		b=`{winread addr}
		echo -n '#'^$a(1)^',#'^$b(2) | winwrite addr
		winread xdata
	} <[3]/mnt/acme/$winid/addr
}

fn windel {
	if(~ $1 sure)
		winctl delete
	if not
		winctl del
}

fn wineventloop {
	{ . <{acmeevent <[0=3] >[2]/dev/null} } <>[3]/mnt/acme/$winid/event
}
